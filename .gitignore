## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific folders
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# VS Code test folder
.vscode-test/

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
.nuget/packages/

# Test Results
[Tt]est[Rr]esult*/
[Bb]enchmark[Dd]ot[Nn]et.Artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish output
publish/

# IIS Express
iisexpress/

# Azure
PublishScripts/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# DotNet tools
.dotnet/

# Local secrets
secrets.json

# Node (if your project has a frontend)
node_modules/
dist/